# Copy to terraform.tfvars (gitignored) and fill in.
# Nothing here is secret — app secrets live in SSM Parameter Store and are
# inserted by hand with the AWS CLI, never through Terraform.

# Public half of the admin SSH key:
#   ssh-keygen -y -f ~/.ssh/terminal-app.pem
ssh_public_key = "ssh-rsa AAAA... admin@example"

# Public half of the CI deploy keypair (matches the EC2_SSH_KEY GitHub secret).
ci_deploy_public_key = "ssh-ed25519 AAAA... github-actions-deploy"

# Existing Elastic IP to re-associate. It is looked up, never managed, so an
# apply or destroy can't release it.
eip_allocation_id = "eipalloc-xxxxxxxxxxxxxxxxx"
