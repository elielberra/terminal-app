FROM golang:1.27.3-trixie@sha256:af1bfc2614ebb1dbd31af514b78740fd678850e76498762b425ecee4c5c6ea80 AS builder

WORKDIR /app

COPY go.mod go.sum ./

RUN go mod download

COPY main.go ./

RUN CGO_ENABLED=0 GOOS=linux GOARCH=arm64 go build -o terminal-app main.go

FROM debian:trixie@sha256:9c6e381421d0f48d1b8133e573f33c185ee16cbf505eda9c4a8a4791b25ea8a6

WORKDIR /app

RUN apt update \
 && apt install -y --no-install-recommends mpv libcaca0 ncurses-term curl gnupg jq libcap2-bin\
 && rm -rf /var/lib/apt/lists/*

RUN useradd -m -u 1000 -s /usr/sbin/nologin app-user \
 && useradd -m -u 1001 -s /usr/sbin/nologin web-user

COPY ./ /app
 
RUN cat ./bashrc-append >> /home/web-user/.bashrc

RUN mkdir -p /etc/gnupg \
  && printf '%s\n' 'pinentry-mode loopback' > /etc/gnupg/gpg.conf

COPY --from=builder /app/terminal-app /app
 
RUN chmod 0100 terminal-app \
  && chown app-user:app-user terminal-app \
  && setcap cap_setuid,cap_setgid+ep terminal-app

USER app-user

CMD ["/app/terminal-app"]