events {}

http {
    # All three server_names now share one listening socket (:80), so their
    # hash table must fit the 56-char .onion address too.
    server_names_hash_bucket_size 128;

    server {
        listen 80;
        server_name www.elielberra.com;
        return 301 https://elielberra.com$request_uri;
    }
    server {
        listen 80;
        server_name elielberra.com;

        # cloudflared connects here over plain HTTP on localhost; Cloudflare
        # terminates TLS at its edge and forwards the real client IP.
        location /ws {
            proxy_pass http://terminal-app:8080;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $http_cf_connecting_ip;
            proxy_read_timeout 3600s;
        }

        location / {
            proxy_pass http://terminal-app:8080;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $http_cf_connecting_ip;
        }
    }
    server {
        listen 80;
        server_name varayg7x6dwre6i5hbcyoxa5zi3t766lnlszvqawhmi6hdfx4c4dyxqd.onion;

        location /ws {
            proxy_pass http://terminal-app:8080;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_read_timeout 3600s;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }

        location / {
            proxy_pass http://terminal-app:8080;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }
    }
}
