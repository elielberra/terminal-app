FROM python:3.14.10-slim-trixie@sha256:af8a5aa14780025dbfbcfbc81bd8a91ebd87711dd5b0f48ed71090949dd7cb1d

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_PROJECT_ENVIRONMENT=/usr/local \
    UV_NO_CACHE=1 \
    HF_HUB_DISABLE_TELEMETRY=1

WORKDIR /rag-chain

COPY --from=ghcr.io/astral-sh/uv:0.13.7@sha256:96f40d3904aad8d0bd010539001d36c8e2188b981e1334471a90c4a1d93bb490 /uv /bin/uv

COPY pyproject.toml uv.lock ./
RUN uv sync --locked --no-dev --no-install-project

RUN useradd -m -u 1001 app-rag-chain

RUN mkdir -p /rag-chain/store && chown -R app-rag-chain:app-rag-chain /rag-chain

USER app-rag-chain

EXPOSE 5000

CMD ["python", "main.py"]
